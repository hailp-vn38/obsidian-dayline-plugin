{
	"name": "obsidian-dayline-plugin",
	"version": "1.3.0",
	"description": "Dayline plugin for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"benchmark": "vitest bench --run",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^1.53.1",
		"@eslint/js": "9.30.1",
		"@types/node": "18.19.121",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "2.1.9"
	},
	"dependencies": {
		"obsidian": "latest",
		"preact": "^10.26.10",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
